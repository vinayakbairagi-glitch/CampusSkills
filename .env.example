# Vercel frontend: add this in Project Settings > Environment Variables.
VITE_API_URL=https://your-backend-host.example.com

# Spring Boot backend: configure these in your backend hosting provider.
SPRING_PROFILES_ACTIVE=mysql
DATABASE_URL=jdbc:mysql://your-db-host:3306/campusskills?useSSL=true&serverTimezone=UTC
DATABASE_USERNAME=campusskills_user
DATABASE_PASSWORD=replace-with-a-strong-database-password
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
CORS_ALLOWED_ORIGINS=https://your-vercel-project.vercel.app
CAMPUS_ADMIN_EMAIL=Campus_admin@campus.edu.in
CAMPUS_ADMIN_PASSWORD=replace-with-a-strong-password-of-at-least-12-characters
PASSWORD_RESET_FRONTEND_URL=https://your-vercel-project.vercel.app

# Optional backend settings
PORT=8080
DDL_AUTO=update
H2_CONSOLE_ENABLED=false
