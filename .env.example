# CampusSkills single-project Vercel Services deployment
# No VITE_API_URL is needed: React calls the Java API through the same domain.

# Java Spring Boot backend
SPRING_PROFILES_ACTIVE=mysql
PORT=80
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
CORS_ALLOWED_ORIGINS=https://your-project.vercel.app
CAMPUS_ADMIN_EMAIL=admin@your-domain.example
CAMPUS_ADMIN_PASSWORD=replace-with-a-strong-password-of-at-least-12-characters
PASSWORD_RESET_FRONTEND_URL=https://your-project.vercel.app

# TiDB Cloud Vercel Marketplace integration (MySQL-compatible).
# These are normally injected by the integration; do not commit real values.
TIDB_HOST=your-tidb-host.example.com
TIDB_PORT=4000
TIDB_DATABASE=campusskills
TIDB_USER=your-tidb-user
TIDB_PASSWORD=replace-with-database-password

# Alternative: for a different managed MySQL service, use MYSQLHOST,
# MYSQLPORT, MYSQLDATABASE, MYSQLUSER, and MYSQLPASSWORD instead.
# Or set DATABASE_URL to a JDBC URL and DATABASE_USERNAME/DATABASE_PASSWORD.
